<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Quản lý Sách</title>
  <style>
    body { margin: 0; font-family: Arial, sans-serif; background: #f3f6fa; color: #17212b; }
    header, footer { padding: 20px; background: #17456b; color: white; text-align: center; }
    main { max-width: 1000px; margin: 24px auto; padding: 0 16px; }
    section { background: white; padding: 20px; margin-bottom: 20px; border-radius: 10px; }
    form { display: grid; gap: 12px; max-width: 450px; }
    label { display: grid; gap: 5px; }
    input, button { padding: 10px; font: inherit; }
    button { border: 0; background: #176b53; color: white; cursor: pointer; }
    .error { padding: 10px; background: #ffe5e5; color: #8b1e1e; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 10px; border-bottom: 1px solid #ddd; text-align: left; }
  </style>
</head>
<body>
  <header><h1>Quản lý Sách</h1></header>
  <main>{{{body}}}</main>
  <footer>{{studentName}} — MSSV: {{studentId}} — VAT áp dụng: {{vatPercent}}%</footer>
</body>
</html>